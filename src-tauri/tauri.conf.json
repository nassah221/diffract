{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Diffract",
  "version": "0.0.1",
  "identifier": "com.diffract.app",
  "build": {
    "beforeDevCommand": "node scripts/prepare-mcp.mjs && pnpm dev",
    "devUrl": "http://localhost:1422",
    "beforeBuildCommand": "node scripts/prepare-mcp.mjs && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Diffract",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#ffffff"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "diffract"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/Assets.car",
      "icons/diffity-logo.icon",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/diffity-mcp",
      "binaries/diffity-cli"
    ],
    "macOS": {
      "minimumSystemVersion": "13.3"
    }
  }
}
