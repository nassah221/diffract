{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Diffract Dev",
  "identifier": "com.diffract.app.dev",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Diffract Dev",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#ffffff"
      }
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["diffract-dev"]
      }
    }
  },
  "bundle": {
    "icon": [
      "icons/dev/diffract-dev.icon",
      "icons/dev/32x32.png",
      "icons/dev/64x64.png",
      "icons/dev/128x128.png",
      "icons/dev/128x128@2x.png",
      "icons/dev/icon.icns"
    ]
  }
}
